{
  "name": "klever",
  "version": "0.7.0",
  "private": true,
  "description": "Klever (beta gratuita): carteras simuladas. Cloudflare Pages + Functions + D1.",
  "type": "module",
  "scripts": {
    "db:reset": "bash scripts/local/servidor.sh reset",
    "dev": "bash scripts/local/arrancar.sh",
    "servidor:start": "bash scripts/local/servidor.sh start",
    "servidor:stop": "bash scripts/local/servidor.sh stop",
    "test": "bash tests/run-all.sh",
    "demo:build": "python3 scripts/demo/build_demo.py",
    "test:servidor": "node tests/ronda7/unit-servidor.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "wrangler": "3.114.17"
  },
  "engines": {
    "node": ">=20"
  }
}
