{
  "name": "klever-app",
  "version": "1.0.0-beta.0",
  "private": true,
  "type": "module",
  "description": "Klever v1 (Nácar): carteras simuladas. Cloudflare Pages + Functions + D1.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "node e2e/ejecutar.mjs",
    "db:local": "wrangler d1 execute klever --local --file=schema.sql",
    "servidor": "wrangler pages dev dist --port 8788"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250408.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.0.4",
    "wrangler": "^3.114.17"
  },
  "dependencies": {
    "@fontsource-variable/commissioner": "^5.1.1",
    "@fontsource-variable/fraunces": "^5.1.1",
    "@fontsource/ibm-plex-mono": "^5.1.1"
  }
}
